# ── Backend selection ──────────────────────────────────────
# Options: local | twilio | signalwire
CALL_BACKEND=local

# ── Local SIP (free, used when CALL_BACKEND=local) ─────────
TARGET=sip:5061@127.0.0.1

# ── Twilio (used when CALL_BACKEND=twilio) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── SignalWire (used when CALL_BACKEND=signalwire) ──────────
SW_PROJECT_ID=
SW_TOKEN=
SW_SPACE_URL=
SW_FROM_NUMBER=

# ── Real IVR phone number (twilio / signalwire backends) ───
TARGET_IVR_NUMBER=

# ── Ollama ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Network simulation (macOS interface, usually en0) ──────
NETWORK_INTERFACE=en0
